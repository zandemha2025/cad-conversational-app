# ScaleCAD Backend — Environment Variables
# Copy to backend/.env and fill in values, OR run: ./setup.sh from project root

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ScaleCAD API
APP_VERSION=0.1.0
ENVIRONMENT=production     # development | production
DEBUG=false
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...   # service_role key (NOT anon key)
SUPABASE_ANON_KEY=eyJhbGc...      # anon/public key

# From: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# From: Project Settings → Database → Connection string (URI mode)
# Paste as-is — the app auto-converts postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Gemini (Google AI) ────────────────────────────────────────────────────────
# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Zoo.dev (KCL → glTF compiler) ────────────────────────────────────────────
# From: https://zoo.dev → Account → API Keys
ZOO_API_KEY=sk-zoo-...
ZOO_API_URL=https://api.zoo.dev

# ── Cloudflare R2 (object storage) ───────────────────────────────────────────
# From: https://dash.cloudflare.com → R2 → Manage API Tokens
R2_ACCOUNT_ID=abc123...
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET=scalecad-files
R2_PUBLIC_URL=https://pub-xxx.r2.dev    # or custom domain

# ── Upstash Redis (Celery broker) ─────────────────────────────────────────────
# From: https://console.upstash.com → your database → .env tab
REDIS_URL=rediss://default:PASSWORD@your-endpoint.upstash.io:6380

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
